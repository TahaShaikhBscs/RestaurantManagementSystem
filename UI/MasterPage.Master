                        <li class="nav-item">
                            <a class="nav-link" href="Orders/OrderList.aspx">
                                <i class="fas fa-receipt me-1"></i>Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="Kitchen/KitchenDisplay.aspx">
                                <i class="fas fa-utensil-spoon me-1"></i>Kitchen
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="fas fa-chart-line me-1"></i>Reports
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="Reports/SalesReport.aspx"><i class="fas fa-chart-bar me-1"></i>Sales</a></li>
                                <li><a class="dropdown-item" href="Reports/ExpenseReport.aspx"><i class="fas fa-money-bill-wave me-1"></i>Expenses</a></li>
                                <li><a class="dropdown-item" href="Reports/ProfitLoss.aspx"><i class="fas fa-file-invoice me-1"></i>Profit & Loss</a></li>
