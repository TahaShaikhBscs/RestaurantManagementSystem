                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>
                                <asp:Literal ID="ltrUserName" runat="server" Text="User" />
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="Settings/Profile.aspx"><i class="fas fa-user me-1"></i>Profile</a></li>
                                <li><a class="dropdown-item" href="Settings/ChangePassword.aspx"><i class="fas fa-key me-1"></i>Change Password</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="Logout.aspx"><i class="fas fa-sign-out-alt me-1"></i>Logout</a></li>
