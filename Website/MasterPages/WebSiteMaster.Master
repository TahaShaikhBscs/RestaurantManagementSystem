

<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="WebSiteMaster.master.cs" Inherits="RestaurantManagementSystem.Website.MasterPages.WebSiteMaster" %>
<%@ Register Src="~/Website/Controls/Header.ascx" TagPrefix="uc1" TagName="Header" %>
<%@ Register Src="~/Website/Controls/Footer.ascx" TagPrefix="uc2" TagName="Footer" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Dynamic Title -->
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Restaurant Name - Fine Dining</asp:ContentPlaceHolder></title>
    
    <!-- Dynamic Meta Tags -->
    <meta name="description" content="<asp:ContentPlaceHolder ID="MetaDescription" runat="server">Experience fine dining at its best.</asp:ContentPlaceHolder>" />
    <meta name="keywords" content="<asp:ContentPlaceHolder ID="MetaKeywords" runat="server">restaurant, fine dining, gourmet, food</asp:ContentPlaceHolder>" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="<asp:ContentPlaceHolder ID="OgTitle" runat="server">Restaurant Name</asp:ContentPlaceHolder>" />
    <meta property="og:description" content="<asp:ContentPlaceHolder ID="OgDescription" runat="server">Experience fine dining at its best.</asp:ContentPlaceHolder>" />
    <meta property="og:image" content="<asp:ContentPlaceHolder ID="OgImage" runat="server">/Website/Assets/images/og-image.jpg</asp:ContentPlaceHolder>" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href="<asp:ContentPlaceHolder ID="CanonicalUrl" runat="server">https://www.restaurantname.com</asp:ContentPlaceHolder>" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="<asp:Literal ID="ltrFavicon" runat="server" Text="/Website/Assets/images/favicon.ico" />" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    
    <!-- Dynamic Theme CSS -->
    <style id="themeStyles">
        /* Theme variables will be injected here */
    </style>
    
    <!-- Custom CSS -->
    <link href="/Website/Assets/css/style.css" rel="stylesheet" />
    <link href="/Website/Assets/css/responsive.css" rel="stylesheet" />
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        
        <!-- Header -->
        <uc1:Header ID="HeaderControl" runat="server" />
        
        <!-- Main Content -->
        <asp:UpdatePanel ID="MainContentUpdatePanel" runat="server" UpdateMode="Conditional">
            <ContentTemplate>
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </ContentTemplate>
        </asp:UpdatePanel>

        <asp:UpdateProgress ID="MainContentUpdateProgress" runat="server" AssociatedUpdatePanelID="MainContentUpdatePanel" DisplayAfter="250">
            <ProgressTemplate>
                <div class="position-fixed top-50 start-50 translate-middle bg-white border rounded shadow px-3 py-2" style="z-index: 10000;">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    Updating...
                </div>
            </ProgressTemplate>
        </asp:UpdateProgress>
        
        <!-- Footer -->
        <uc2:Footer ID="FooterControl" runat="server" />
        
        <!-- Back to Top -->
        <button class="btn btn-primary back-to-top" id="backToTop">
            <i class="fas fa-chevron-up"></i>
        </button>
        
        <!-- Scripts -->
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/Website/Assets/js/main.js"></script>
        <script src="/Website/Assets/js/slider.js"></script>
        <script src="/Website/Assets/js/theme.js"></script>
        
        <asp:ContentPlaceHolder ID="ScriptsContent" runat="server"></asp:ContentPlaceHolder>
    </form>
</body>
</html>
